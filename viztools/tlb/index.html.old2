<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Translation lookaside buffers</title>
<style>
:root{
  --paper:#e9eef2;
  --grid:#dae2e8;
  --ink:#172033;
  --ink-soft:#4d596b;
  --panel:#f8fafb;
  --line:#d3dbe2;
  --bad:#c92a2a;
  --good:#2b8a3e;
  --mark:#ffd43b;
  --hit:#b2f2bb;
  --miss:#ffc9c9;
  --arr:#1864ab;
  --pt:#a5d8ff;
  --p1:#1864ab;
  --p2:#9c36b5;
  --hatch:repeating-linear-gradient(135deg,#f4f7f9 0 7px,#dfe6ec 7px 8px);
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  --sans: "Avenir Next", Avenir, "Segoe UI Variable Text", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0}
body{
  background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:24px 24px;
  color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.5;
}
[hidden]{display:none !important}
.instant *{transition:none !important}
.page{max-width:1280px;margin:0 auto;padding:32px 28px 56px}

.top{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;margin-bottom:20px}
h1{font-size:2.35rem;line-height:1.1;margin:0 0 10px;font-weight:700;letter-spacing:-.01em}
.intro{margin:0;max-width:72ch;color:var(--ink-soft)}
h2{font-size:1.05rem;margin:0 0 4px;font-weight:700}
h3{font-size:.95rem;margin:14px 0 6px;font-weight:700}
.sub{margin:0 0 12px;font-size:.88rem;color:var(--ink-soft)}
.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
button,select{font:inherit;font-size:.95rem;color:var(--ink);background:var(--panel);border:2px solid var(--ink);border-radius:6px;padding:7px 14px;cursor:pointer}
button:hover:not(:disabled){background:#fff}
button:disabled{opacity:.4;cursor:default}
button.primary{background:var(--ink);color:#fff}
button.primary:hover:not(:disabled){background:#2c3a57}
:focus-visible{outline:3px solid var(--mark);outline-offset:2px}
.speed{display:flex;align-items:center;gap:6px;font-size:.9rem;color:var(--ink-soft)}
select{padding:6px 8px}
.panel{background:var(--panel);border:2px solid var(--ink);border-radius:8px;padding:16px 18px;min-width:0}

/* section headings */
.chapter{margin:34px 0 14px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.chapter h2{font-size:1.5rem;letter-spacing:-.01em}
.chapter span{font-size:.9rem;color:var(--ink-soft)}
.rule{height:3px;background:var(--ink);border-radius:2px;margin:0 0 18px}

/* setup */
.setup{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:20px;margin-bottom:12px;align-items:start}
.assume{display:grid;grid-template-columns:auto 1fr;gap:3px 14px;margin:0;font-size:.92rem}
.assume dt{color:var(--ink-soft)}
.assume dd{margin:0;font-family:var(--mono);font-size:.86rem}
.trow{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:flex-end}
.trow label{display:flex;flex-direction:column;font-size:.84rem;color:var(--ink-soft);gap:3px}
.trow input{font-family:var(--mono);font-size:1rem;width:92px;padding:6px 8px;border:2px solid var(--ink);border-radius:6px;background:#fff;color:var(--ink)}
.trow select{width:auto}
.trow input[aria-invalid="true"]{border-color:var(--bad);box-shadow:0 0 0 2px #ffd6d6}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;align-items:center}
.chips > span{font-size:.88rem;color:var(--ink-soft)}
.chip{font-size:.85rem;padding:3px 10px;border-width:1.5px;border-radius:999px}
.tmsg{margin:8px 0 0;font-size:.88rem;color:var(--ink-soft)}
.tmsg.err{color:var(--bad);font-weight:600}

/* step card */
.card{border-width:3px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start;min-height:186px;margin-bottom:12px}
.step-count{margin:0 0 2px;font-size:.9rem;color:var(--ink-soft)}
.card h2{font-size:1.5rem;line-height:1.2;margin:0 0 8px}
.card p.body{margin:0;max-width:64ch}
.calc{margin:0;align-self:center;padding:10px 12px;background:#fff;border-left:4px solid var(--ink);font-family:var(--mono);font-size:13.5px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.card.hit{border-color:var(--good)}
.card.miss{border-color:var(--bad)}
.card.hit .calc{border-left-color:var(--good)}
.card.miss .calc{border-left-color:var(--bad)}
.verdict{display:inline-block;font-size:.8rem;font-weight:700;border-radius:999px;padding:1px 10px;border:2px solid var(--ink);margin-left:8px;vertical-align:middle}
.verdict.hit{background:var(--hit)}
.verdict.miss{background:var(--miss)}

/* timeline */
.timeline{display:flex;flex-wrap:wrap;gap:10px;row-gap:10px;margin:0 0 22px;padding:12px 14px 8px;background:var(--panel);border:2px solid var(--ink);border-radius:8px}
.tl-group{min-width:40px;display:flex;flex-direction:column;gap:5px}
.tl-steps{display:flex;gap:2px}
.tl-step{flex:1;height:16px;padding:0;border:0;border-radius:2px;background:var(--g);opacity:.28;min-width:5px}
.tl-step:hover{opacity:.6}
.tl-step.done{opacity:1}
.tl-step.now{opacity:1;box-shadow:0 0 0 2px var(--panel),0 0 0 4px var(--ink)}
.tl-step.hit{background:var(--good)}
.tl-step.miss{background:var(--bad)}
.tl-label{font-family:var(--mono);font-size:11.5px;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* main grid */
.main{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.85fr);gap:20px;align-items:start}
.side{display:flex;flex-direction:column;gap:20px;min-width:0}

/* virtual memory grid */
.vmwrap{overflow-x:auto}
table.vm{border-collapse:collapse;font-family:var(--mono);font-size:12px;margin:0 auto}
.vm th{font-weight:600;color:var(--ink-soft);font-size:11px;padding:2px 6px;white-space:nowrap}
.vm th.vpn{text-align:right}
.vm caption{caption-side:top;font-family:var(--sans);font-size:.78rem;color:var(--ink-soft);letter-spacing:.08em;padding-bottom:4px}
.vm td{width:46px;height:24px;border:1px solid #b9c4ce;text-align:center;background:#fff;transition:background-color .25s,box-shadow .2s}
.vm td.a{background:var(--pt)}
.vm td.now{box-shadow:inset 0 0 0 3px var(--mark),inset 0 0 0 5px var(--ink);font-weight:700}
.vm tr.cached th.vpn{color:var(--good);font-weight:700}
.vm tr.cached th.vpn::after{content:" \2022"}
.vm tr.curpage td{background-image:linear-gradient(#ffe8a3,#ffe8a3)}
.vm tr.curpage td.a{background-image:none;background-color:#9ccdf5}

/* TLB table */
table.tlb{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12.5px}
.tlb th{font-family:var(--sans);font-size:.75rem;font-weight:600;color:var(--ink-soft);text-align:left;border-bottom:2px solid var(--ink);padding:3px 6px;white-space:nowrap}
.tlb td{padding:5px 6px;border-bottom:1px solid var(--line);white-space:nowrap;transition:background-color .3s}
.tlb tr.empty td{color:#9aa6b2;background:var(--hatch)}
.tlb tr.hit td{background:var(--hit)}
.tlb tr.fill td{background:var(--mark)}
.tlb tr.evict td{background:var(--miss)}
.tlb td.asid1{color:var(--p1);font-weight:700}
.tlb td.asid2{color:var(--p2);font-weight:700}

/* access log */
.log{display:flex;flex-wrap:wrap;gap:4px;margin:0;padding:0;list-style:none}
.log li{font-family:var(--mono);font-size:11.5px;border:1.5px solid var(--ink);border-radius:4px;padding:2px 6px;background:#fff;opacity:.25;transition:opacity .25s}
.log li.on{opacity:1}
.log li.hit{background:var(--hit)}
.log li.miss{background:var(--miss)}
.log li.now{box-shadow:0 0 0 2px var(--mark)}

/* counters */
.counts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:14px}
.count{border:2px solid var(--ink);border-radius:6px;background:#fff;padding:6px 8px}
.count b{display:block;font-family:var(--mono);font-size:1.4rem;line-height:1.1}
.count span{font-size:.8rem;color:var(--ink-soft)}
.sbar{display:flex;height:20px;border:2px solid var(--ink);border-radius:4px;overflow:hidden;background:#fff;margin-top:10px}
.sbar i{display:block;height:100%;transition:width .3s}
.sbar .h{background:var(--good)}
.sbar .m{background:var(--bad)}
.takeaway{margin:10px 0 0;padding:9px 12px;border-left:4px solid var(--good);background:#fff;font-size:.9rem}
.takeaway.bad{border-left-color:var(--bad)}

/* address split */
.split-addr{display:flex;gap:3px;flex-wrap:wrap;margin:0 0 8px}
.bitbox{font-family:var(--mono);font-size:13px;font-weight:700;width:22px;height:26px;display:grid;place-items:center;border:1.5px solid var(--ink);border-radius:3px;background:#fff}
.bitbox.v{background:var(--arr);color:#fff;border-color:var(--arr)}
.bitgap{width:8px}
.blegend{display:flex;gap:14px;font-size:.8rem;color:var(--ink-soft);margin:0 0 10px}
dl.xl{display:grid;grid-template-columns:auto 1fr;gap:0;margin:0;border:1.5px solid var(--ink);border-radius:6px;overflow:hidden;background:#fff}
.xl dt,.xl dd{margin:0;padding:6px 10px;border-top:1px solid var(--line)}
.xl dt:first-of-type,.xl dd:first-of-type{border-top:0}
.xl dt{font-size:.85rem;color:var(--ink-soft);background:#f4f6f8}
.xl dd{font-family:var(--mono);font-size:13px}
.xl .hl,.xl dt.hl{background:#ffe8a3}

/* bit-field diagram */
svg.fields{display:block;width:100%;max-width:960px;height:auto;margin:0 auto;font-family:var(--mono)}
.fields rect.f{stroke:var(--ink);stroke-width:1.5;cursor:pointer}
.fields rect.f.sel{stroke-width:3.5}
.fields text{font-size:12px;fill:var(--ink)}
.fields text.w{font-size:10.5px;fill:var(--ink-soft);font-family:var(--sans)}
.fieldnote{margin:12px 0 0;padding:10px 12px;background:#fff;border-left:4px solid var(--ink);min-height:74px}
.fieldnote b{display:block;font-family:var(--mono)}
.fieldnote p{margin:2px 0 0;font-size:.9rem}

/* two-column compare */
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:start}
ol.flow{margin:0;padding-left:20px;font-size:.92rem}
ol.flow li{margin-bottom:5px}
ol.flow code,p code,li code,td code{font-family:var(--mono);font-size:.86em;background:#fff;border:1px solid var(--line);border-radius:3px;padding:0 4px}
.tag{display:inline-block;font-size:.75rem;font-weight:700;border:2px solid var(--ink);border-radius:999px;padding:1px 9px;margin-bottom:8px;background:var(--mark)}
.warn{margin:12px 0 0;padding:10px 12px;border:2px dashed var(--bad);border-radius:6px;background:#fff;font-size:.9rem}
.warn b{color:var(--bad)}

/* context switch demo */
.procs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:12px}
.proc{border:2px solid var(--line);border-radius:6px;background:#fff;padding:8px 10px;transition:border-color .25s,box-shadow .25s}
.proc.on{border-color:var(--ink);box-shadow:0 0 0 3px var(--mark)}
.proc b{font-family:var(--mono);font-size:.9rem}
.proc.p1 b{color:var(--p1)}
.proc.p2 b{color:var(--p2)}
.proc span{display:block;font-size:.82rem;color:var(--ink-soft)}
.switchbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.seg{display:inline-flex;border:2px solid var(--ink);border-radius:999px;overflow:hidden}
.seg button{border:0;border-radius:0;padding:5px 14px;font-size:.88rem;background:var(--panel)}
.seg button.on{background:var(--ink);color:#fff}

/* charts */
svg.mini{display:block;width:100%;height:auto;font-family:var(--sans)}
.mini .bar{stroke:var(--ink);stroke-width:1.5}
.mini text{font-size:12px;fill:var(--ink)}
.mini text.small{font-size:11px;fill:var(--ink-soft);font-family:var(--mono)}
.cov{display:flex;height:26px;border:2px solid var(--ink);border-radius:4px;overflow:hidden;background:var(--hatch);margin-top:8px}
.cov i{display:block;height:100%;background:var(--pt);transition:width .3s}

.tabs{display:flex;gap:6px;margin:0 0 22px;padding:5px;background:var(--panel);border:2px solid var(--ink);border-radius:10px;overflow-x:auto}
.tabs button{flex:1 1 0;min-width:132px;display:flex;flex-direction:column;align-items:flex-start;gap:1px;border:0;border-radius:6px;background:transparent;padding:7px 12px;text-align:left;line-height:1.25}
.tabs button b{font-size:.95rem;white-space:nowrap}
.tabs button span{font-size:.78rem;color:var(--ink-soft);white-space:nowrap}
.tabs button:hover{background:#fff}
.tabs button[aria-selected="true"]{background:var(--ink);color:#fff}
.tabs button[aria-selected="true"] span{color:#c8d2e0}
.controls.off{visibility:hidden}
.kbd-hint{margin:14px 0 0;font-size:.85rem;color:var(--ink-soft)}
kbd{font-family:var(--mono);font-size:12px;border:1px solid var(--ink-soft);border-bottom-width:2px;border-radius:3px;padding:0 5px;background:#fff}
.foot{margin-top:34px;font-size:.85rem;color:var(--ink-soft)}

@media (max-width: 1100px){
  .main{grid-template-columns:1fr}
  .three{grid-template-columns:1fr}
}
@media (max-width: 980px){
  .top,.setup,.two,.procs{grid-template-columns:1fr}
  .controls{justify-content:flex-start}
  .card{grid-template-columns:1fr;gap:12px;min-height:0}
}
@media (max-width: 640px){
  .page{padding:20px 14px 36px}
  h1{font-size:1.75rem}
  .tl-label{display:none}
  .counts{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (prefers-reduced-motion: reduce){
  *{transition:none !important}
}
</style>
</head>
<body>
<div class="page">

  <header class="top">
    <div>
      <h1>Translation lookaside buffers</h1>
      <p class="intro">Paging makes every memory reference cost an extra read of the page table. A TLB is a small, fully associative cache of translations inside the MMU that removes most of those reads. The tabs below walk through the array example from OSTEP Chapter 19, then through the problems a TLB creates.</p>
    </div>
    <div class="controls">
      <button id="btnRestart" type="button">Restart</button>
      <button id="btnPrev" type="button">Back</button>
      <button id="btnPlay" type="button">Play</button>
      <button id="btnNext" type="button" class="primary">Next step</button>
      <label class="speed">Speed
        <select id="speed">
          <option value="2400">Slow</option>
          <option value="1400" selected>Normal</option>
          <option value="650">Fast</option>
        </select>
      </label>
    </div>
  </header>

  <nav class="tabs" id="tabs" role="tablist" aria-label="Sections">
    <button type="button" role="tab" id="tab1" data-t="1" aria-controls="panel1" aria-selected="true"><b>1. Spatial locality</b><span>the array loop</span></button>
    <button type="button" role="tab" id="tab2" data-t="2" aria-controls="panel2" aria-selected="false"><b>2. Handling a miss</b><span>hardware or software</span></button>
    <button type="button" role="tab" id="tab3" data-t="3" aria-controls="panel3" aria-selected="false"><b>3. Inside an entry</b><span>the MIPS R4000</span></button>
    <button type="button" role="tab" id="tab4" data-t="4" aria-controls="panel4" aria-selected="false"><b>4. Context switches</b><span>flush or ASID</span></button>
    <button type="button" role="tab" id="tab5" data-t="5" aria-controls="panel5" aria-selected="false"><b>5. Replacement</b><span>LRU or random</span></button>
    <button type="button" role="tab" id="tab6" data-t="6" aria-controls="panel6" aria-selected="false"><b>6. Coverage</b><span>when it stops fitting</span></button>
  </nav>

  <div class="tabpanel" id="panel1" role="tabpanel" aria-labelledby="tab1">

  <div class="chapter"><h2>1. Why a TLB works: spatial locality</h2><span>the array loop from the chapter</span></div>
  <div class="rule"></div>

  <div class="setup">
    <section class="panel" aria-label="Assumptions">
      <h2>Assumptions</h2>
      <dl class="assume" id="assume"></dl>
      <p class="sub" style="margin:10px 0 0">The trace counts only the array accesses, as the chapter's example does. Instruction fetches would add TLB lookups of their own.</p>
    </section>
    <section class="panel" aria-label="Experiment">
      <h2>Change the experiment</h2>
      <p class="sub">Anything that puts more elements on one page raises the hit rate.</p>
      <div class="trow">
        <label>Page size
          <select id="pageSize">
            <option value="16" selected>16 bytes</option>
            <option value="32">32 bytes</option>
            <option value="64">64 bytes</option>
          </select>
        </label>
        <label>Array starts at VA
          <input type="number" id="baseAddr" min="0" max="252" step="4" value="100">
        </label>
        <label>Elements
          <input type="number" id="nElems" min="1" max="32" step="1" value="10">
        </label>
        <label>TLB entries
          <input type="number" id="tlbSize" min="1" max="8" step="1" value="4">
        </label>
        <label>Loop runs
          <select id="repeats">
            <option value="1" selected>once</option>
            <option value="2">twice</option>
            <option value="3">three times</option>
          </select>
        </label>
        <button type="button" id="btnRun">Run</button>
      </div>
      <div class="chips">
        <span>Or try</span>
        <button type="button" class="chip" data-p="16" data-b="100" data-n="10" data-t="4" data-r="1">the slide</button>
        <button type="button" class="chip" data-p="16" data-b="100" data-n="10" data-t="4" data-r="2">run the loop twice</button>
        <button type="button" class="chip" data-p="64" data-b="100" data-n="10" data-t="4" data-r="1">bigger pages</button>
        <button type="button" class="chip" data-p="16" data-b="100" data-n="8" data-t="4" data-r="1">8 elements, unaligned</button>
        <button type="button" class="chip" data-p="16" data-b="96" data-n="8" data-t="4" data-r="1">8 elements, page-aligned</button>
        <button type="button" class="chip" data-p="16" data-b="0" data-n="32" data-t="4" data-r="2">working set &gt; TLB</button>
      </div>
      <p class="tmsg" id="tMsg" role="status"></p>
    </section>
  </div>

  <section class="panel card" id="card" aria-live="polite">
    <div>
      <p class="step-count" id="stepCount"></p>
      <h2 id="stepTitle"></h2>
      <p class="body" id="stepBody"></p>
    </div>
    <pre class="calc" id="stepCalc"></pre>
  </section>

  <nav class="timeline" id="timeline" aria-label="Jump to a step"></nav>

  <div class="main">
    <section class="panel">
      <h2>The virtual address space</h2>
      <p class="sub">One row per virtual page, one cell per 4-byte element. Blue cells hold the array; a dot marks pages whose translation is in the TLB right now.</p>
      <div class="vmwrap"><table class="vm" id="vm"></table></div>
      <div style="margin-top:14px">
        <h3 style="margin-top:0">The access sequence</h3>
        <ul class="log" id="log"></ul>
      </div>
      <div class="counts">
        <div class="count"><b id="cHit">0</b><span>hits</span></div>
        <div class="count"><b id="cMiss">0</b><span>misses</span></div>
        <div class="count"><b id="cRate">—</b><span>TLB hit rate</span></div>
      </div>
      <div class="sbar"><i class="h" id="sH"></i><i class="m" id="sM"></i></div>
      <p class="takeaway" id="take">Press Next step or Play to run the loop.</p>
    </section>

    <div class="side">
      <section class="panel">
        <h2>This lookup</h2>
        <p class="sub" id="lookSub">Nothing accessed yet.</p>
        <div class="split-addr" id="bits"></div>
        <p class="blegend"><span><b style="color:var(--arr)">VPN</b> high bits</span><span>offset low bits</span></p>
        <dl class="xl" id="xl"></dl>
      </section>

      <section class="panel">
        <h2>The TLB</h2>
        <p class="sub" id="tlbSub">Fully associative: every entry is searched in parallel.</p>
        <table class="tlb" id="tlbTable"></table>
        <p class="sub" style="margin:10px 0 0">Managed here with LRU replacement. The valid bit says whether the entry holds a translation at all, which is not the same as the page table's valid bit.</p>
      </section>
    </div>
  </div>

  <p class="kbd-hint">Keyboard: <kbd>&larr;</kbd> <kbd>&rarr;</kbd> to step, <kbd>Space</kbd> to play or pause.</p>

  </div>

  <div class="tabpanel" id="panel2" role="tabpanel" aria-labelledby="tab2" hidden>
  <div class="chapter"><h2>2. Who handles a TLB miss</h2><span>hardware-managed or software-managed</span></div>
  <div class="rule"></div>

  <div class="two">
    <section class="panel">
      <span class="tag">Hardware-managed</span>
      <h2>The MMU walks the page table itself</h2>
      <p class="sub">CISC designs, including x86. The hardware has to know exactly where the page table is and what its format looks like.</p>
      <ol class="flow">
        <li>Extract the VPN and search the TLB.</li>
        <li>On a miss the hardware reads the page-table base register <code>CR3</code> and walks the table in memory.</li>
        <li>If the entry is valid and the access is permitted, the hardware installs the translation in the TLB.</li>
        <li>The instruction is retried, and this time it hits.</li>
      </ol>
      <p class="sub" style="margin-top:10px">The OS is never involved, so nothing is entered or left. The cost is a rigid page-table format baked into the chip.</p>
    </section>
    <section class="panel">
      <span class="tag">Software-managed</span>
      <h2>The hardware raises an exception and the OS fills the TLB</h2>
      <p class="sub">RISC designs, including MIPS and SPARC v9. The hardware only needs a way to write TLB entries.</p>
      <ol class="flow">
        <li>Extract the VPN and search the TLB.</li>
        <li>On a miss the hardware raises an exception and traps into the kernel.</li>
        <li>The trap handler looks up the translation in whatever data structure the OS chose, and writes it into the TLB with a privileged instruction.</li>
        <li>Return-from-trap <strong>retries the faulting instruction</strong>, unlike a system call, where it resumes at the instruction after.</li>
      </ol>
      <p class="sub" style="margin-top:10px">The OS can use any page-table structure it likes. The price is the trap, which costs more than a hardware walk.</p>
    </section>
  </div>

  <div class="warn" style="margin-top:20px"><b>The circularity to avoid.</b> The TLB miss handler is itself code at some virtual address, and the page table it reads lives at some virtual address too, so handling the miss can cause another miss, forever. Two ways out: keep the handler in unmapped physical memory, or reserve permanently valid <em>wired</em> entries in the TLB for the handler's own translations. The handler also has to be careful where it saves registers, since the trap arrives with the faulting instruction's state live.</div>

  </div>

  <div class="tabpanel" id="panel3" role="tabpanel" aria-labelledby="tab3" hidden>
  <div class="chapter"><h2>3. What is in a TLB entry</h2><span>the MIPS R4000, 32 bits and 64 entries</span></div>
  <div class="rule"></div>

  <section class="panel">
    <p class="sub">A typical entry is 64 bits wide, holding far more than a VPN and a PFN. Tap a field to read what it does. A TLB is fully associative, so the VPN is stored in the entry rather than implied by position, and all 64 entries are compared at once.</p>
    <svg class="fields" id="fields" viewBox="0 0 940 150" role="img" aria-label="MIPS R4000 TLB entry layout"></svg>
    <div class="fieldnote" id="fieldNote"></div>
    <p class="sub" style="margin:12px 0 0">The R4000 has 64 entries, a few of which the OS can wire down. It exposes four privileged instructions: <code>TLBP</code> probes for a VPN, <code>TLBR</code> reads an entry, <code>TLBWI</code> writes a specific entry, and <code>TLBWR</code> writes a random one. Only 19 VPN bits are user-visible because the top half of the address space is reserved for the kernel.</p>
  </section>

  </div>

  <div class="tabpanel" id="panel4" role="tabpanel" aria-labelledby="tab4" hidden>
  <div class="chapter"><h2>4. Context switches</h2><span>the same VPN, a different process</span></div>
  <div class="rule"></div>

  <section class="panel">
    <p class="sub">TLB entries are only meaningful for the process that installed them. Both of these processes have a page 10, and they map to different frames. Something has to keep the second process from using the first one's translation.</p>
    <div class="procs">
      <div class="proc p1" id="procP1"><b>Process 1 &mdash; ASID 1</b><span>VPN 10 &rarr; PFN 101</span><span>VPN 11 &rarr; PFN 103</span></div>
      <div class="proc p2" id="procP2"><b>Process 2 &mdash; ASID 2</b><span>VPN 10 &rarr; PFN 170</span><span>VPN 12 &rarr; PFN 159</span></div>
    </div>
    <div class="switchbar">
      <div class="seg" role="group" aria-label="Policy">
        <button type="button" id="polFlush" class="on">Flush on switch</button>
        <button type="button" id="polAsid">Tag with an ASID</button>
      </div>
      <button type="button" id="csNext" class="primary">Next event</button>
      <button type="button" id="csReset">Reset</button>
    </div>
    <div class="two">
      <div>
        <table class="tlb" id="csTable"></table>
        <p class="sub" style="margin-top:8px">Page 10 appears twice under ASIDs, which is fine: the comparison includes the ASID, so process 2 can never match process 1's entry.</p>
      </div>
      <div>
        <p class="body" id="csMsg" style="margin:0"></p>
        <div class="counts" style="grid-template-columns:repeat(2,minmax(0,1fr))">
          <div class="count"><b id="csHits">0</b><span>hits</span></div>
          <div class="count"><b id="csMisses">0</b><span>misses</span></div>
        </div>
        <p class="takeaway" id="csTake"></p>
      </div>
    </div>
    <p class="sub" style="margin:14px 0 0">Two processes can also share a page on purpose: different VPNs in different address spaces pointing at the same PFN, which saves memory when a code page is used by many processes.</p>
  </section>

  </div>

  <div class="tabpanel" id="panel5" role="tabpanel" aria-labelledby="tab5" hidden>
  <div class="chapter"><h2>5. Which entry to replace</h2><span>and why LRU can be the worst possible choice</span></div>
  <div class="rule"></div>

  <section class="panel">
    <p class="sub">When the TLB is full, installing a new translation means evicting an old one. LRU is the obvious answer and usually a good one, but a loop that touches one more page than the TLB can hold defeats it completely: the entry evicted is always the one needed next.</p>
    <div class="trow" style="margin-bottom:12px">
      <label>TLB entries
        <input type="number" id="rpTlb" min="2" max="8" step="1" value="4">
      </label>
      <label>Pages in the loop
        <input type="number" id="rpPages" min="2" max="12" step="1" value="5">
      </label>
      <label>Accesses
        <input type="number" id="rpN" min="10" max="200" step="10" value="60">
      </label>
      <button type="button" id="rpRun">Simulate</button>
    </div>
    <div class="two">
      <div><svg class="mini" id="rpChart" viewBox="0 0 420 200" role="img" aria-label="Hit rate by policy"></svg></div>
      <div>
        <dl class="xl" id="rpOut"></dl>
        <p class="takeaway" id="rpTake"></p>
      </div>
    </div>
    <p class="sub" style="margin:14px 0 0">Random has no worst case to fall into, which is exactly why it is used. The R4000's <code>TLBWR</code> instruction writes a random entry in hardware.</p>
  </section>

  </div>

  <div class="tabpanel" id="panel6" role="tabpanel" aria-labelledby="tab6" hidden>
  <div class="chapter"><h2>6. TLB coverage</h2><span>when the working set no longer fits</span></div>
  <div class="rule"></div>

  <section class="panel">
    <p class="sub">A TLB only covers entries &times; page size bytes of memory. A program that touches more than that in a tight loop misses constantly, however good its locality is. This is why databases and other large-footprint programs ask for large pages.</p>
    <div class="trow" style="margin-bottom:10px">
      <label>TLB entries
        <select id="covEntries">
          <option value="32">32</option>
          <option value="64" selected>64</option>
          <option value="128">128</option>
          <option value="512">512</option>
          <option value="1536">1536</option>
        </select>
      </label>
      <label>Page size
        <select id="covPage">
          <option value="4096" selected>4 KB</option>
          <option value="2097152">2 MB</option>
          <option value="1073741824">1 GB</option>
        </select>
      </label>
      <label>Working set
        <input type="number" id="covWs" min="1" max="100000" step="1" value="64">
      </label>
      <label>Units
        <select id="covUnit">
          <option value="1048576" selected>MB</option>
          <option value="1073741824">GB</option>
        </select>
      </label>
    </div>
    <div class="two">
      <div>
        <dl class="xl" id="covOut"></dl>
        <div class="cov"><i id="covFill"></i></div>
        <p class="takeaway" id="covTake"></p>
      </div>
      <div>
        <h3 style="margin-top:0">Two more places a TLB shows up</h3>
        <p class="sub" style="margin-bottom:8px"><strong>Caches.</strong> A physically indexed cache needs the translation before it can even start the lookup, so a TLB miss lands on the critical path of every access. Virtually indexed caches skip that wait but bring problems of their own.</p>
        <p class="sub" style="margin-bottom:0"><strong>Fast processors.</strong> On a superscalar or out-of-order CPU the TLB can become the bottleneck, because dozens of instructions per cycle each need a translation. That is a fine example of a general rule: a change that speeds things up at one level exposes the next level as the new limit.</p>
      </div>
    </div>
  </section>

  </div>

  <p class="foot">Worked example, numbers and issues follow OSTEP, Chapter 19, <em>Paging: Faster Translations (TLBs)</em>.</p>
</div>

<script>
const $ = id => document.getElementById(id);
const bin = (v, n) => v.toString(2).padStart(n, '0');
const log2 = v => Math.round(Math.log2(v));
const pfnOf = vpn => (vpn * 3 + 5) % 16;   /* a fixed, made-up page table */

/* =========================================================
   Part 1: the array loop
   ========================================================= */
const VA_BITS = 8, VA_SPACE = 256, ELEM = 4;
let cfg = { page: 16, base: 100, n: 10, tlb: 4, reps: 1 };
let accesses = [], steps = [], groups = [];

function simulate () {
  const { page, base, n, tlb, reps } = cfg;
  const offBits = log2(page), vpnBits = VA_BITS - offBits;
  accesses = [];
  let entries = [];              /* {vpn, pfn, used} */
  let clock = 0;

  for (let r = 0; r < reps; r++) {
    for (let i = 0; i < n; i++) {
      const va = base + ELEM * i;
      const vpn = va >> offBits, off = va & (page - 1), pfn = pfnOf(vpn);
      clock++;
      const idx = entries.findIndex(e => e.vpn === vpn);
      let hit = idx >= 0, evicted = null, slot;
      if (hit) {
        entries[idx].used = clock;
        slot = idx;
      } else {
        if (entries.length < tlb) {
          slot = entries.length;
          entries.push({ vpn, pfn, used: clock });
        } else {
          let lru = 0;
          entries.forEach((e, k) => { if (e.used < entries[lru].used) lru = k; });
          evicted = { ...entries[lru] };
          slot = lru;
          entries[lru] = { vpn, pfn, used: clock };
        }
      }
      accesses.push({
        r, i, va, vpn, off, pfn, hit, slot, evicted,
        pa: pfn * page + off,
        tlbAfter: entries.map(e => ({ ...e })),
        vpnBits, offBits,
      });
    }
  }
}

function buildSteps () {
  steps = []; groups = [];
  const { page, base, n, tlb, reps } = cfg;
  const offBits = log2(page), vpnBits = VA_BITS - offBits;
  const group = (label, color) => { groups.push({ label, color, start: steps.length, count: 0 }); return groups.length - 1; };
  const snap = (g, o) => { groups[g].count++; steps.push({ group: g, upto: -1, calc: [], ...o }); };

  const pages = [...new Set(accesses.map(a => a.vpn))];
  const g0 = group('setup', '#7d8b99');
  snap(g0, {
    title: 'A loop over an array',
    body: `The loop reads a[0] through a[${n - 1}]. Each element is ${ELEM} bytes, so ${page / ELEM} of them fit on a ${page}-byte page and the array covers ${pages.length} page${pages.length === 1 ? '' : 's'}. The TLB starts empty, so the first access to each page has to miss.`,
    calc: [
      `for (i = 0; i < ${n}; i++)`,
      `    sum += a[i];`,
      ``,
      `a[i] at VA ${base} + ${ELEM}i`,
      `VPN = VA >> ${offBits}   offset = VA & ${page - 1}`,
      `pages touched: ${pages.join(', ')}`,
    ],
  });

  let g = null;
  accesses.forEach((a, k) => {
    if (a.i === 0) g = group(reps > 1 ? `run ${a.r + 1}` : 'the loop', a.r % 2 ? '#495a73' : '#172033');
    const b = bin(a.va, VA_BITS);
    let body, calc;
    if (a.hit) {
      body = `Page ${a.vpn} is already in the TLB, put there by an earlier element on the same page. The translation comes straight out of the TLB and no page-table read is needed.`
        + (a.r > 0 && a.i === 0 ? ' This is temporal locality rather than spatial: the page is still cached from the previous run of the loop.' : '');
      calc = [`VA ${a.va} = ${b.slice(0, vpnBits)} ${b.slice(vpnBits)}`, `VPN ${a.vpn}, offset ${a.off}`, `TLB hit: PFN ${a.pfn}`, `PA = ${a.pfn} x ${page} + ${a.off} = ${a.pa}`];
    } else {
      body = `Page ${a.vpn} is not in the TLB. The hardware or the OS walks the page table, finds PFN ${a.pfn}, and installs the translation`
        + (a.evicted ? `, evicting page ${a.evicted.vpn} because the TLB is full and that entry was used least recently.` : ` in entry ${a.slot}.`)
        + ' The access then costs an extra memory reference, but it pays for the elements that follow on the same page.';
      calc = [`VA ${a.va} = ${b.slice(0, vpnBits)} ${b.slice(vpnBits)}`, `VPN ${a.vpn}, offset ${a.off}`, `TLB miss: walk the page table`, `PTE[${a.vpn}].PFN = ${a.pfn}, install`, `PA = ${a.pfn} x ${page} + ${a.off} = ${a.pa}`];
    }
    snap(g, { upto: k, title: `a[${a.i}]${reps > 1 ? ` (run ${a.r + 1})` : ''}: TLB ${a.hit ? 'hit' : 'miss'}`, verdict: a.hit ? 'hit' : 'miss', body, calc });
  });

  const hits = accesses.filter(a => a.hit).length;
  const total = accesses.length;
  const rate = Math.round(hits / total * 100);
  const perPage = page / ELEM;
  const ge = group('result', '#7d8b99');
  snap(ge, {
    upto: total - 1, final: true,
    title: `${hits} hits and ${total - hits} misses: a hit rate of ${rate}%`,
    body: `Nothing about the program changed to earn those hits. The array elements simply sit next to each other, so one miss brings in a translation that the next ${perPage - 1} accesses reuse. That is spatial locality.`
      + (cfg.reps > 1 ? ' Running the loop again reuses the same translations without any new misses, as long as the pages stay in the TLB, which is temporal locality.' : '')
      + (total - hits > new Set(accesses.map(a => a.vpn)).size ? ' Here some pages had to be fetched more than once, because the loop touches more pages than the TLB can hold.' : ''),
    calc: [`accesses:  ${total}`, `hits:      ${hits}`, `misses:    ${total - hits}`, `hit rate:  ${hits}/${total} = ${rate}%`, ``, `elements per page: ${page} / ${ELEM} = ${perPage}`],
  });
}

/* ---------- rendering ---------- */
function buildGrid () {
  const { page } = cfg;
  const cols = page / ELEM, rows = VA_SPACE / page;
  const arrCells = new Set();
  for (let i = 0; i < cfg.n; i++) arrCells.add(cfg.base + ELEM * i);
  let h = `<caption>OFFSET</caption><tr><th></th>`;
  for (let c = 0; c < cols; c++) h += `<th>${String(c * ELEM).padStart(2, '0')}</th>`;
  h += `</tr>`;
  for (let v = 0; v < rows; v++) {
    h += `<tr data-vpn="${v}"><th class="vpn">VPN = ${String(v).padStart(2, '0')}</th>`;
    for (let c = 0; c < cols; c++) {
      const va = v * page + c * ELEM;
      const isA = arrCells.has(va);
      const idx = isA ? (va - cfg.base) / ELEM : -1;
      h += `<td data-va="${va}" class="${isA ? 'a' : ''}" title="VA ${va}">${isA ? 'a[' + idx + ']' : ''}</td>`;
    }
    h += `</tr>`;
  }
  $('vm').innerHTML = h;
}

function buildLog () {
  $('log').innerHTML = accesses.map((a, k) =>
    `<li data-k="${k}" class="${a.hit ? 'hit' : 'miss'}" title="a[${a.i}] at VA ${a.va}, page ${a.vpn}">a[${a.i}] ${a.hit ? 'hit' : 'miss'}</li>`).join('');
}

function renderTlb (a, phase) {
  const rows = [];
  const list = a ? a.tlbAfter : [];
  for (let s = 0; s < cfg.tlb; s++) {
    const e = list[s];
    let cls = '';
    if (a && s === a.slot) cls = a.hit ? 'hit' : 'fill';
    rows.push(e
      ? `<tr class="${cls}"><td>${s}</td><td>1</td><td>${e.vpn}</td><td>${e.pfn}</td><td>rwx</td><td>1</td></tr>`
      : `<tr class="empty"><td>${s}</td><td>0</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td></tr>`);
  }
  $('tlbTable').innerHTML =
    `<thead><tr><th>#</th><th>Valid</th><th>VPN</th><th>PFN</th><th>Prot</th><th>ASID</th></tr></thead><tbody>${rows.join('')}</tbody>`;
  $('tlbSub').textContent = a && !a.hit && a.evicted
    ? `Entry ${a.slot} was replaced: page ${a.evicted.vpn} left to make room for page ${a.vpn}.`
    : 'Fully associative: every entry is searched in parallel.';
}

function renderLookup (a) {
  if (!a) {
    $('lookSub').textContent = 'Nothing accessed yet.';
    $('bits').innerHTML = '';
    $('xl').innerHTML = '<dt>Virtual address</dt><dd>&mdash;</dd><dt>VPN | offset</dt><dd>&mdash;</dd><dt>TLB</dt><dd>&mdash;</dd><dt>Physical address</dt><dd>&mdash;</dd>';
    return;
  }
  const b = bin(a.va, VA_BITS);
  $('lookSub').innerHTML = `a[${a.i}] at virtual address ${a.va} <span class="verdict ${a.hit ? 'hit' : 'miss'}">${a.hit ? 'TLB hit' : 'TLB miss'}</span>`;
  let bh = '';
  for (let i = 0; i < VA_BITS; i++) {
    if (i === a.vpnBits) bh += '<span class="bitgap"></span>';
    bh += `<span class="bitbox ${i < a.vpnBits ? 'v' : ''}">${b[i]}</span>`;
  }
  $('bits').innerHTML = bh;
  const row = (k, v, hl) => `<dt class="${hl ? 'hl' : ''}">${k}</dt><dd class="${hl ? 'hl' : ''}">${v}</dd>`;
  $('xl').innerHTML =
    row('Virtual address', `${a.va} = 0b${b}`, false) +
    row('VPN | offset', `VPN ${a.vpn}, offset ${a.off}`, false) +
    row('TLB lookup', a.hit ? `hit in entry ${a.slot}` : `miss, then install in entry ${a.slot}`, true) +
    row('Page table', a.hit ? 'not read' : `PTE[${a.vpn}] &rarr; PFN ${a.pfn}`, !a.hit) +
    row('Physical address', `${a.pfn} &times; ${cfg.page} + ${a.off} = <strong>${a.pa}</strong>`, false);
}

function renderCounts (step) {
  const done = accesses.slice(0, step.upto + 1);
  const hits = done.filter(a => a.hit).length, miss = done.length - hits;
  $('cHit').textContent = hits;
  $('cMiss').textContent = miss;
  $('cRate').textContent = done.length ? `${Math.round(hits / done.length * 100)}%` : '—';
  const tot = Math.max(1, done.length);
  $('sH').style.width = `${hits / tot * 100}%`;
  $('sM').style.width = `${miss / tot * 100}%`;
  const take = $('take');
  if (!done.length) { take.textContent = 'Press Next step or Play to run the loop.'; take.className = 'takeaway'; return; }
  const perPage = cfg.page / ELEM;
  if (step.final) {
    const pagesTouched = new Set(accesses.map(a => a.vpn)).size;
    if (miss > pagesTouched) {
      take.textContent = `${miss} misses for only ${pagesTouched} distinct pages: the loop's working set is larger than the ${cfg.tlb}-entry TLB, so pages are evicted before they are reused.`;
      take.className = 'takeaway bad';
    } else {
      take.textContent = `One miss per page and ${perPage - 1} hits behind it. With ${perPage} elements on a page, the best a single pass can do is ${Math.round((1 - 1 / perPage) * 100)}%.`;
      take.className = 'takeaway';
    }
  } else {
    const a = accesses[step.upto];
    take.textContent = a.hit
      ? `a[${a.i}] shares page ${a.vpn} with an element already looked up, so the translation was already there.`
      : `a[${a.i}] is the first access to page ${a.vpn}, so this one had to miss.`;
    take.className = 'takeaway' + (a.hit ? '' : ' bad');
  }
}

function renderCard (i) {
  const s = steps[i];
  $('stepCount').textContent = `Step ${i + 1} of ${steps.length}`;
  $('stepTitle').innerHTML = s.title + (s.verdict ? ` <span class="verdict ${s.verdict}">${s.verdict}</span>` : '');
  $('stepBody').textContent = s.body;
  $('stepCalc').textContent = s.calc.join('\n');
  $('card').className = 'panel card' + (s.verdict ? ' ' + s.verdict : '');
}

function buildTimeline () {
  $('timeline').innerHTML = groups.map(g => {
    let b = '';
    for (let i = g.start; i < g.start + g.count; i++) {
      const s = steps[i];
      const t = s.title.replace(/"/g, '&quot;');
      b += `<button class="tl-step${s.verdict ? ' ' + s.verdict : ''}" type="button" data-i="${i}" aria-label="Step ${i + 1}: ${t}" title="Step ${i + 1}: ${t}"></button>`;
    }
    return `<div class="tl-group" style="flex:${g.count} 1 0;--g:${g.color}"><div class="tl-steps">${b}</div><div class="tl-label">${g.label}</div></div>`;
  }).join('');
}
$('timeline').addEventListener('click', e => {
  const b = e.target.closest('.tl-step');
  if (b) { stop(); go(+b.dataset.i); }
});

function render (i, animate = true) {
  current = i;
  const root = document.documentElement;
  if (!animate) root.classList.add('instant');
  const step = steps[i];
  const a = step.upto >= 0 && !step.final ? accesses[step.upto] : null;
  renderCard(i);
  document.querySelectorAll('.tl-step').forEach(b => {
    const k = +b.dataset.i;
    b.classList.toggle('done', k < i);
    b.classList.toggle('now', k === i);
    b.setAttribute('aria-current', k === i ? 'step' : 'false');
  });
  /* grid */
  const cached = new Set(step.upto >= 0 ? accesses[step.upto].tlbAfter.map(e => e.vpn) : []);
  document.querySelectorAll('#vm tr[data-vpn]').forEach(tr => {
    const v = +tr.dataset.vpn;
    tr.classList.toggle('cached', cached.has(v));
    tr.classList.toggle('curpage', !!a && a.vpn === v);
  });
  document.querySelectorAll('#vm td').forEach(td => td.classList.toggle('now', !!a && +td.dataset.va === a.va));
  /* log */
  document.querySelectorAll('#log li').forEach(li => {
    const k = +li.dataset.k;
    li.classList.toggle('on', k <= step.upto);
    li.classList.toggle('now', !!a && k === step.upto);
  });
  renderLookup(a);
  renderTlb(step.upto >= 0 ? accesses[step.upto] : null);
  renderCounts(step);
  $('btnPrev').disabled = i === 0;
  $('btnNext').disabled = i === steps.length - 1;
  if (!animate) requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('instant')));
}

let current = 0, timer = null;
function go (i) { if (i >= 0 && i < steps.length && i !== current) render(i); }
function play () {
  stop();
  if (current >= steps.length - 1) render(0);
  $('btnPlay').textContent = 'Pause';
  const tick = () => {
    if (current >= steps.length - 1) { stop(); return; }
    go(current + 1);
    timer = setTimeout(tick, +$('speed').value);
  };
  timer = setTimeout(tick, +$('speed').value);
}
function stop () { clearTimeout(timer); timer = null; $('btnPlay').textContent = 'Play'; }
$('btnNext').onclick = () => { stop(); go(current + 1); };
$('btnPrev').onclick = () => { stop(); go(current - 1); };
$('btnPlay').onclick = () => (timer ? stop() : play());
$('btnRestart').onclick = () => { stop(); render(0); };
document.addEventListener('keydown', e => {
  if (e.target.closest('select, input, #tabs')) return;
  if (typeof tab !== 'undefined' && tab !== 1) return;
  if (e.key === 'ArrowRight') { stop(); go(current + 1); e.preventDefault(); }
  else if (e.key === 'ArrowLeft') { stop(); go(current - 1); e.preventDefault(); }
  else if (e.key === ' ' && !e.target.closest('button')) { timer ? stop() : play(); e.preventDefault(); }
  else if (e.key === 'Home') { stop(); render(0); }
});

function renderAssume () {
  const { page } = cfg;
  const offBits = log2(page), vpnBits = VA_BITS - offBits;
  $('assume').innerHTML = [
    ['Virtual address space', `${VA_SPACE} bytes (8-bit addresses)`],
    ['Page size', `${page} bytes`],
    ['Address split', `${vpnBits}-bit VPN, ${offBits}-bit offset`],
    ['Pages', `2^${vpnBits} = ${VA_SPACE / page}`],
    ['Array', `${cfg.n} ints of ${ELEM} bytes at VA ${cfg.base} (${bin(cfg.base, 8)}b)`],
    ['TLB', `${cfg.tlb} entries, fully associative, LRU`],
  ].map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('');
}

function setMsg (t, err) { $('tMsg').textContent = t; $('tMsg').className = 'tmsg' + (err ? ' err' : ''); }

function apply (page, base, n, tlbn, reps, autoplay) {
  const ok = (v, lo, hi) => Number.isInteger(v) && v >= lo && v <= hi;
  const bOk = ok(base, 0, VA_SPACE - ELEM) && base % ELEM === 0;
  const nOk = ok(n, 1, 32);
  $('baseAddr').toggleAttribute('aria-invalid', !bOk);
  $('nElems').toggleAttribute('aria-invalid', !nOk);
  if (!bOk) { setMsg(`The array must start at a multiple of ${ELEM}, from 0 to ${VA_SPACE - ELEM}.`, true); return; }
  if (!nOk) { setMsg('Elements must be a whole number from 1 to 32.', true); return; }
  if (!ok(tlbn, 1, 8)) { setMsg('The TLB must have 1 to 8 entries.', true); return; }
  let note = '';
  if (base + ELEM * n > VA_SPACE) {
    n = Math.floor((VA_SPACE - base) / ELEM);
    $('nElems').value = n;
    note = ` Only ${n} elements fit above VA ${base} in a ${VA_SPACE}-byte space.`;
  }
  stop();
  cfg = { page, base, n, tlb: tlbn, reps };
  simulate(); buildSteps(); buildGrid(); buildLog(); buildTimeline(); renderAssume();
  render(0, false);
  const hits = accesses.filter(a => a.hit).length;
  const pages = new Set(accesses.map(a => a.vpn)).size;
  const miss = accesses.length - hits;
  const pl = (v, w) => `${v} ${w}${v === 1 ? '' : 'es'}`;
  setMsg(`${n} element${n === 1 ? '' : 's'} over ${pages} page${pages === 1 ? '' : 's'}, ${cfg.reps > 1 ? cfg.reps + ' runs, ' : ''}${accesses.length} accesses: ${hits} hit${hits === 1 ? '' : 's'} and ${pl(miss, 'miss')}, a hit rate of ${Math.round(hits / accesses.length * 100)}%.${note}`, false);
  if (autoplay) play();
}
const readForm = () => [+$('pageSize').value, Number($('baseAddr').value), Number($('nElems').value), Number($('tlbSize').value), +$('repeats').value];
$('btnRun').onclick = () => apply(...readForm(), true);
['baseAddr', 'nElems', 'tlbSize'].forEach(id => $(id).addEventListener('keydown', e => { if (e.key === 'Enter') $('btnRun').click(); }));
['pageSize', 'repeats'].forEach(id => $(id).addEventListener('change', () => apply(...readForm(), false)));
document.querySelectorAll('.chip').forEach(c => {
  c.onclick = () => {
    $('pageSize').value = c.dataset.p; $('baseAddr').value = c.dataset.b;
    $('nElems').value = c.dataset.n; $('tlbSize').value = c.dataset.t; $('repeats').value = c.dataset.r;
    apply(+c.dataset.p, +c.dataset.b, +c.dataset.n, +c.dataset.t, +c.dataset.r, true);
  };
});

/* =========================================================
   Part 3: the entry layout
   ========================================================= */
const FIELDS = [
  { n: 'VPN', w: 19, c: '#a5d8ff', d: 'The virtual page number this entry translates. It is stored in the entry because the TLB is fully associative, so an entry can sit anywhere. Only 19 of the 20 possible bits are here: the top half of the address space belongs to the kernel.' },
  { n: 'G', w: 1, c: '#ffd8a8', d: 'Global. Set for pages shared by every process, which makes the hardware ignore the ASID when matching.' },
  { n: 'ASID', w: 8, c: '#d0bfff', d: 'Address space identifier. It tells the hardware which process the entry belongs to, so the TLB does not have to be flushed on every context switch. With only 8 bits there are 256 of them, and the OS has to recycle them.' },
  { n: 'unused', w: 4, c: '#e9ecef', d: 'Unused bits, kept for a future use that a chip designer had in mind.' },
  { n: 'PFN', w: 24, c: '#b2f2bb', d: 'The physical frame number this page maps to. This is the answer the lookup exists to produce.' },
  { n: 'C', w: 3, c: '#ffec99', d: 'Coherence. It says how the hardware should cache this page, which matters on a multiprocessor.' },
  { n: 'D', w: 1, c: '#ffc9c9', d: 'Dirty. Set when the page has been written, so the OS knows the copy in memory differs from the one on disk.' },
  { n: 'V', w: 1, c: '#a5d8ff', d: 'Valid. A valid entry holds a usable translation. This is not the page table valid bit: an invalid page-table entry means the page was never allocated and touching it is a fault, while an invalid TLB entry simply means this slot holds nothing.' },
  { n: 'spare', w: 3, c: '#e9ecef', d: 'A few more spare bits.' },
];
function buildFields () {
  const total = FIELDS.reduce((s, f) => s + f.w, 0);
  const X0 = 20, W = 900, Y = 58, H = 46;
  let x = X0, h = '';
  h += `<text x="${X0}" y="22" font-size="12" fill="var(--ink-soft)" font-family="var(--sans)">64 bits, drawn to scale</text>`;
  h += `<text x="${X0 + W / 4}" y="42" font-size="12" fill="var(--ink-soft)" font-family="var(--sans)" text-anchor="middle">what the hardware matches: 32 bits</text>`;
  h += `<text x="${X0 + 3 * W / 4}" y="42" font-size="12" fill="var(--ink-soft)" font-family="var(--sans)" text-anchor="middle">what it returns: 32 bits</text>`;
  FIELDS.forEach((f, i) => {
    const w = f.w / total * W;
    h += `<g class="fgroup" data-i="${i}"><rect class="f" data-i="${i}" x="${x}" y="${Y}" width="${w}" height="${H}" fill="${f.c}"><title>${f.n}, ${f.w} bits</title></rect>`;
    if (w > 34) h += `<text x="${x + w / 2}" y="${Y + 24}" text-anchor="middle" pointer-events="none">${f.n}</text><text class="w" x="${x + w / 2}" y="${Y + 39}" text-anchor="middle" pointer-events="none">${f.w}</text>`;
    else h += `<line x1="${x + w / 2}" y1="${Y + H}" x2="${x + w / 2}" y2="${Y + H + 8}" stroke="var(--ink-soft)" stroke-width="1.2" pointer-events="none"/><text x="${x + w / 2}" y="${Y + H + 21}" font-size="12" text-anchor="middle" pointer-events="none">${f.n}</text>`;
    h += `</g>`;
    x += w;
  });
  h += `<line x1="${X0 + W / 2}" y1="${Y - 10}" x2="${X0 + W / 2}" y2="${Y + H + 10}" stroke="var(--ink)" stroke-width="2" stroke-dasharray="5 4"/>`;
  $('fields').innerHTML = h;
  selectField(0);
}
function selectField (i) {
  const f = FIELDS[i];
  document.querySelectorAll('#fields rect.f').forEach(r => r.classList.toggle('sel', +r.dataset.i === i));
  $('fieldNote').innerHTML = `<b>${f.n} &mdash; ${f.w} bit${f.w === 1 ? '' : 's'}</b><p>${f.d}</p>`;
}
$('fields').addEventListener('click', e => {
  const r = e.target.closest('rect.f') || e.target.closest('.fgroup');
  if (r) selectField(+r.dataset.i);
});

/* =========================================================
   Part 4: context switches
   ========================================================= */
const CS_MAP = { 1: { 10: 101, 11: 103 }, 2: { 10: 170, 12: 159 } };
const CS_EVENTS = [
  { t: 'access', p: 1, vpn: 10 }, { t: 'access', p: 1, vpn: 11 },
  { t: 'switch', p: 2 },
  { t: 'access', p: 2, vpn: 10 }, { t: 'access', p: 2, vpn: 12 },
  { t: 'switch', p: 1 },
  { t: 'access', p: 1, vpn: 10 }, { t: 'access', p: 1, vpn: 11 },
];
let csPolicy = 'flush', csStep = -1, csTlb = [], csCur = 1, csH = 0, csM = 0;
const CS_CAP = 4;

function csReset () {
  csStep = -1; csTlb = []; csCur = 1; csH = 0; csM = 0;
  csRender('Process 1 is running and the TLB is empty. Step through: each process reads its page 10, then the scheduler switches.');
}
function csRender (msg, flash) {
  const rows = [];
  for (let s = 0; s < CS_CAP; s++) {
    const e = csTlb[s];
    rows.push(e
      ? `<tr class="${flash === s ? (e.justHit ? 'hit' : 'fill') : ''}"><td>1</td><td>${e.vpn}</td><td>${e.pfn}</td><td class="asid${e.asid}">${csPolicy === 'asid' ? e.asid : '—'}</td></tr>`
      : `<tr class="empty"><td>0</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td></tr>`);
  }
  $('csTable').innerHTML = `<thead><tr><th>Valid</th><th>VPN</th><th>PFN</th><th>ASID</th></tr></thead><tbody>${rows.join('')}</tbody>`;
  $('csMsg').textContent = msg;
  $('csHits').textContent = csH; $('csMisses').textContent = csM;
  $('procP1').classList.toggle('on', csCur === 1);
  $('procP2').classList.toggle('on', csCur === 2);
  const done = csStep >= CS_EVENTS.length - 1;
  $('csTake').textContent = csPolicy === 'flush'
    ? (done ? `Flushing is correct but wasteful: every switch throws away work, and each process starts cold again. Here that cost ${csM} misses.` : 'With flushing, the TLB is emptied on every switch so no stale translation can ever be used.')
    : (done ? `With ASIDs the entries survive the switch, so process 1 hits on page 10 when it comes back. ${csM} misses instead of ${CS_EVENTS.filter(e => e.t === 'access').length}.` : 'With ASIDs, entries from both processes coexist; the hardware compares the ASID along with the VPN.');
  $('csTake').className = 'takeaway' + (csPolicy === 'flush' && done ? ' bad' : '');
  $('csNext').disabled = done;
}
$('csNext').onclick = () => {
  if (csStep >= CS_EVENTS.length - 1) return;
  csStep++;
  const ev = CS_EVENTS[csStep];
  csTlb.forEach(e => { e.justHit = false; });
  if (ev.t === 'switch') {
    csCur = ev.p;
    if (csPolicy === 'flush') { csTlb = []; csRender(`Context switch to process ${ev.p}. The whole TLB is flushed, so nothing is left to translate with.`); }
    else csRender(`Context switch to process ${ev.p}. The ASID register changes; the TLB keeps everything.`);
    return;
  }
  const pfn = CS_MAP[ev.p][ev.vpn];
  const idx = csTlb.findIndex(e => e.vpn === ev.vpn && (csPolicy === 'flush' || e.asid === ev.p));
  if (idx >= 0) {
    csH++; csTlb[idx].justHit = true;
    csRender(`Process ${ev.p} reads a virtual address on page ${ev.vpn}. Hit: PFN ${pfn} comes straight from the TLB.`, idx);
  } else {
    csM++;
    const slot = csTlb.length < CS_CAP ? csTlb.length : 0;
    csTlb[slot] = { vpn: ev.vpn, pfn, asid: ev.p, justHit: false };
    csRender(`Process ${ev.p} reads a virtual address on page ${ev.vpn}. Miss: the entry is installed, mapping page ${ev.vpn} to PFN ${pfn}${csPolicy === 'asid' ? ` under ASID ${ev.p}` : ''}.`, slot);
  }
};
$('csReset').onclick = csReset;
$('polFlush').onclick = () => { csPolicy = 'flush'; $('polFlush').classList.add('on'); $('polAsid').classList.remove('on'); csReset(); };
$('polAsid').onclick = () => { csPolicy = 'asid'; $('polAsid').classList.add('on'); $('polFlush').classList.remove('on'); csReset(); };

/* =========================================================
   Part 5: replacement policy
   ========================================================= */
function runPolicy (policy, tlbN, pages, n, rng) {
  let e = [], hits = 0, clock = 0;
  for (let k = 0; k < n; k++) {
    const vpn = k % pages; clock++;
    const i = e.findIndex(x => x.vpn === vpn);
    if (i >= 0) { hits++; e[i].used = clock; continue; }
    if (e.length < tlbN) e.push({ vpn, used: clock });
    else {
      let victim;
      if (policy === 'lru') { victim = 0; e.forEach((x, j) => { if (x.used < e[victim].used) victim = j; }); }
      else victim = Math.floor(rng() * tlbN);
      e[victim] = { vpn, used: clock };
    }
  }
  return hits / n;
}
function mulberry (a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

function rpRun () {
  const tlbN = Math.min(8, Math.max(2, Math.round(+$('rpTlb').value) || 4));
  const pages = Math.min(12, Math.max(2, Math.round(+$('rpPages').value) || 5));
  const n = Math.min(200, Math.max(10, Math.round(+$('rpN').value) || 60));
  $('rpTlb').value = tlbN; $('rpPages').value = pages; $('rpN').value = n;
  const lru = runPolicy('lru', tlbN, pages, n);
  let rnd = 0;
  for (let t = 0; t < 200; t++) rnd += runPolicy('rand', tlbN, pages, n, mulberry(t + 1));
  rnd /= 200;
  const row = (k, v, hl) => `<dt class="${hl ? 'hl' : ''}">${k}</dt><dd class="${hl ? 'hl' : ''}">${v}</dd>`;
  $('rpOut').innerHTML =
    row('Access pattern', `0, 1, ... ${pages - 1}, 0, 1, ... (${n} accesses)`, false) +
    row('LRU hit rate', `${(lru * 100).toFixed(1)}%`, pages > tlbN) +
    row('Random hit rate', `${(rnd * 100).toFixed(1)}% (mean of 200 runs)`, false) +
    row('Best possible', `${((1 - Math.min(pages, n) / n) * 100).toFixed(1)}% if every page stayed`, false);
  const take = $('rpTake');
  if (pages > tlbN && lru < 0.02) {
    take.textContent = `A loop over ${pages} pages through a ${tlbN}-entry TLB: LRU evicts the page that is about to be needed, every single time, so almost nothing hits. Random, knowing nothing, does better.`;
    take.className = 'takeaway bad';
  } else if (pages <= tlbN) {
    take.textContent = `The loop fits in the TLB, so after the first pass everything hits under either policy. Replacement only matters once the working set overflows.`;
    take.className = 'takeaway';
  } else {
    take.textContent = `With ${pages} pages and ${tlbN} entries both policies lose entries, but LRU no longer hits its worst case.`;
    take.className = 'takeaway';
  }
  /* chart */
  const H = 200, base = 160, top = 30, maxH = base - top;
  const bars = [['LRU', lru, 'var(--bad)'], ['Random', rnd, 'var(--pt)']];
  let h = `<line x1="40" y1="${base}" x2="400" y2="${base}" stroke="var(--ink)" stroke-width="1.5"/>`;
  [0, 0.5, 1].forEach(v => {
    const y = base - v * maxH;
    h += `<line x1="40" y1="${y}" x2="400" y2="${y}" stroke="var(--line)" stroke-width="1"/><text class="small" x="34" y="${y + 4}" text-anchor="end">${v * 100}%</text>`;
  });
  bars.forEach(([label, v, color], i) => {
    const x = 90 + i * 160, w = 100, hh = Math.max(1, v * maxH);
    h += `<rect class="bar" x="${x}" y="${base - hh}" width="${w}" height="${hh}" fill="${color}"/>`;
    h += `<text x="${x + w / 2}" y="${base + 18}" text-anchor="middle">${label}</text>`;
    h += `<text class="small" x="${x + w / 2}" y="${base - hh - 7}" text-anchor="middle">${(v * 100).toFixed(1)}%</text>`;
  });
  h += `<text class="small" x="40" y="${H - 4}">hit rate over ${n} accesses</text>`;
  $('rpChart').innerHTML = h;
}
$('rpRun').onclick = rpRun;
['rpTlb', 'rpPages', 'rpN'].forEach(id => $(id).addEventListener('change', rpRun));

/* =========================================================
   Part 6: coverage
   ========================================================= */
const UNITS = ['bytes', 'KB', 'MB', 'GB', 'TB'];
function human (b) { let u = 0, v = b; while (v >= 1024 && u < UNITS.length - 1) { v /= 1024; u++; } return `${Number.isInteger(v) ? v : v.toFixed(1)} ${UNITS[u]}`; }
function covRun () {
  const e = +$('covEntries').value, p = +$('covPage').value;
  let ws = Number($('covWs').value);
  const ok = Number.isFinite(ws) && ws >= 1 && ws <= 100000;
  $('covWs').toggleAttribute('aria-invalid', !ok);
  if (!ok) { $('covTake').textContent = 'The working set must be a number from 1 to 100,000.'; $('covTake').className = 'takeaway bad'; return; }
  ws = ws * +$('covUnit').value;
  const cover = e * p;
  const row = (k, v, hl) => `<dt class="${hl ? 'hl' : ''}">${k}</dt><dd class="${hl ? 'hl' : ''}">${v}</dd>`;
  $('covOut').innerHTML =
    row('TLB coverage', `${e} &times; ${human(p)} = <strong>${human(cover)}</strong>`, true) +
    row('Working set', human(ws), false) +
    row('Pages needed', Math.ceil(ws / p).toLocaleString(), false) +
    row('Entries available', e.toLocaleString(), false);
  $('covFill').style.width = `${Math.min(100, cover / ws * 100)}%`;
  const take = $('covTake');
  if (cover >= ws) {
    take.textContent = `The whole working set fits in the TLB, so after the first pass a loop over it hits every time.`;
    take.className = 'takeaway';
  } else {
    take.textContent = `The TLB covers only ${(cover / ws * 100).toFixed(1)}% of the working set, so a loop over it misses constantly no matter how good its locality. Larger pages are the usual fix: these same ${e} entries would cover ${human(e * 2097152)} with 2 MB pages.`;
    take.className = 'takeaway bad';
  }
}
['covEntries', 'covPage', 'covUnit'].forEach(id => $(id).addEventListener('change', covRun));
$('covWs').addEventListener('input', covRun);

/* =========================================================
   Tabs
   ========================================================= */
let tab = 1;
function showTab (n) {
  tab = n;
  document.querySelectorAll('#tabs button').forEach(b => b.setAttribute('aria-selected', +b.dataset.t === n ? 'true' : 'false'));
  for (let i = 1; i <= 6; i++) $('panel' + i).hidden = i !== n;
  document.querySelector('.controls').classList.toggle('off', n !== 1);
  if (n !== 1) stop();
  if (history.replaceState) history.replaceState(null, '', '#' + n);
}
$('tabs').addEventListener('click', e => {
  const b = e.target.closest('button[data-t]');
  if (b) showTab(+b.dataset.t);
});
$('tabs').addEventListener('keydown', e => {
  const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
  if (!d) return;
  e.preventDefault();
  const n = ((tab - 1 + d + 6) % 6) + 1;
  showTab(n);
  $('tab' + n).focus();
});

/* =========================================================
   Boot
   ========================================================= */
apply(16, 100, 10, 4, 1, false);
showTab(Math.min(6, Math.max(1, parseInt(location.hash.slice(1), 10) || 1)));
buildFields();
csReset();
rpRun();
covRun();
</script>
</body>
</html>
